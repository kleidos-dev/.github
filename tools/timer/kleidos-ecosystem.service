#
# The local ecosystem report on Linux (docs/ecosystem.md, "The local
# report"), a systemd user service its timer starts. Exit status 1 means the
# report holds something red, which is not a failure of the service.
# @CHECKOUT@ is written by the commands there; %h is the home folder.
[Unit]
Description=Kleidos ecosystem report
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@CHECKOUT@
ExecStartPre=-/usr/bin/git pull -q --ff-only
ExecStart=@CHECKOUT@/.venv/bin/python tools/ecosystem.py report --all --notify --out %h/kleidos-ecosystem
SuccessExitStatus=1
